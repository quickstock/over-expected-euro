# Upstream API response cache (~3.4 GB). Every byte is re-pullable with
# `pull.py`; caching is a local speed optimisation, not source.
cache/

# Built database (~1 GB), regenerated by the pull -> build -> model chain.
euro_oe.db
*.db-journal
*.db-wal
*.parquet

logs_*.txt

# A stale full copy of the NBA pipeline predating the combined site. Not
# source and not a submodule — the real one is ../NBA_OE, published at
# github.com/quickstock/Over-Expected.
NBA_OE copy/

# This build's own front end, superseded by the combined multi-league site in
# ../site (github.com/quickstock/over-expected-site), which was seeded from it.
site/

__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.DS_Store
